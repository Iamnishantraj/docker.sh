#!/bin/bash

# Exit immediately if a command exits with a non-zero status
set -e

echo "=========================================="
echo " Starting Docker Installation Script      "
echo "=========================================="

# Step 1: Update packages
echo "--> Step 1: Updating packages..."
sudo apt update -y

# Step 2: Install Docker
echo "--> Step 2: Installing Docker..."
sudo apt install docker.io -y

# Step 3: Start Docker
echo "--> Step 3: Starting Docker service..."
sudo systemctl start docker

# Step 4: Enable Docker at boot
echo "--> Step 4: Enabling Docker at boot..."
sudo systemctl enable docker

# Step 5: Check Docker status
echo "--> Step 5: Checking Docker status..."
sudo systemctl status docker --no-pager

# Step 6: Check Docker version
echo "--> Step 6: Checking Docker version..."
docker version

echo "=========================================="
echo " Docker Installation Completed Successfully!"
echo "=========================================="
